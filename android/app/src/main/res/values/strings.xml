<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">AXON</string>
    <string name="tagline">On-device agentic runtime</string>

    <!--
      §16 requires the agent's operation to be visible at all times. This is the
      persistent notification text, written to say plainly what is happening —
      not a generic "app is running" that a user would learn to ignore.
    -->
    <string name="gateway_channel_name">AXON agent activity</string>
    <string name="gateway_channel_description">Shown whenever AXON is operating your device.</string>
    <string name="gateway_running">AXON is operating your device</string>
    <string name="gateway_idle">AXON is ready</string>
    <string name="gateway_stop">Stop</string>

    <!-- §16: the user is asked before an irreversible action, and the text names
         the effect rather than the mechanism. A confirmation nobody can evaluate
         is one they learn to dismiss. -->
    <string name="confirm_title">AXON needs your approval</string>
    <string name="confirm_text">Allow AXON to %1$s? (%2$s)</string>
    <string name="confirm_allow">Allow once</string>
    <string name="confirm_deny">No</string>
</resources>
