{
  "id": "settings_toggle",
  "name": "Toggle a device setting",
  "goal_pattern": "turn {state} {setting}",
  "parameters": [
    { "name": "setting", "type": "setting_name", "required": true },
    { "name": "state", "type": "on_off", "required": true }
  ],
  "required_capabilities": ["settings:write", "ui:observe", "ui:gesture", "app:launch"],
  "version": 1
}
