.gradle/
build/
*/build/
*/*/build/
local.properties
.idea/
*.iml
.kotlin/
.DS_Store

# Model weights (§7.3). Multi-GB GGUF files are fetched by tools/fetch-model.sh,
# never committed — a repo an examiner can clone in under a minute matters more
# than one that is self-contained.
models/
*.gguf

# llama.cpp is a submodule at third_party/llama.cpp (see .gitmodules), so it is
# tracked, not ignored. Only the host build output of the grammar checker is.
tools/gbnf-check/build/

# Generated evaluation output (§14). Results are reproduced by running the
# harness; committing them would let a stale table outlive the code that made it.
bench/results/
